<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.DailyObsi"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.EditShortcutWidgetReceiver"
            android:exported="false"
            android:label="@string/edit_shortcut_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/edit_shortcut_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.HeadingWidgetReceiver"
            android:exported="false"
            android:label="@string/heading_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heading_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ReadingViewWidgetReceiver"
            android:exported="false"
            android:label="@string/reading_view_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/reading_view_widget_info" />
        </receiver>

        <!-- Configuration activity for EditShortcutWidget and HeadingWidget
             (both are "pick one heading from today's note" widgets).
             exported=true is required for the system's Home app process to
             launch it via ACTION_APPWIDGET_CONFIGURE across the app
             boundary, same as any other widget config activity. -->
        <activity
            android:name=".widget.HeadingPickerActivity"
            android:exported="true"
            android:theme="@style/Theme.DailyObsi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>
</manifest>
